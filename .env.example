# ═══════════════════════════════════════════════════
# JARVIS TRADING — CONFIGURATION
# ═══════════════════════════════════════════════════
# Copy this file to .env and fill in your keys.
# DO NOT share your .env file with anyone.
# ═══════════════════════════════════════════════════

# YOUR IDENTITY (Required for shared Firebase)
# Sign into the app → Settings → copy your User ID
# This ensures Jarvis only monitors YOUR trades, not other users'.
OWNER_USER_ID=""

# GEMINI AI KEY (Required — powers the voice assistant)
# As of v1.7.0 Jarvis uses a free rules engine for trade decisions; Gemini is
# used ONLY for the voice interface. Expect ~$3–$5/month at default settings.
# Get yours free at: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# APP URL (leave as-is for local development)
APP_URL="http://localhost:3000"

# ═══════════════════════════════════════════════════
# SAFETY — paper trading by default
# ═══════════════════════════════════════════════════
# When true (default), every trade is paper money. The trade executor refuses
# live-mode requests and converts them to paper. To enable real-money trades:
#   1. Set LIVE_TRADING_DISABLED=false here
#   2. Provide LIVE broker keys (Binance / Alpaca LIVE — Alpaca paper keys
#      start with PK and auto-route to paper regardless of this flag)
# Strongly recommended: leave this at true until you've watched several
# full paper-mode trade lifecycles play out cleanly.
LIVE_TRADING_DISABLED=true

# ═══════════════════════════════════════════════════
# Strategy engine — legacy LLM swarm vs new rules engine
# ═══════════════════════════════════════════════════
# v1.7.0 ships a free rules-based orchestrator (replaces the 6-agent LLM
# swarm). Default routing sends /api/swarm/run to the orchestrator. Set this
# to 'true' if you want to reach the old LLM swarm code for side-by-side
# comparison (still in the tree). Will be removed in v1.8 unless valuable.
USE_LEGACY_SWARM=false

# BINANCE API KEYS (Optional — needed for live crypto trading)
# Get yours at: https://www.binance.com/en/my/settings/api-management
# Required permissions: Enable Reading, Enable Spot & Margin Trading
# Recommended: leave "Enable Withdrawals" OFF for safety.
BINANCE_API_KEY=""
BINANCE_SECRET_KEY=""

# ALPACA API KEYS (Optional — needed for US stocks / commodity ETF trading)
# Sign up free at: https://alpaca.markets
# Paper trading keys: https://paper-api.alpaca.markets (no brokerage approval required)
# Live trading keys: requires brokerage application (1-3 business days)
ALPACA_API_KEY_ID=""
ALPACA_SECRET_KEY=""

# TELEGRAM NOTIFICATIONS (Optional)
# 1. Message @BotFather on Telegram → /newbot → copy the token
# 2. Message @userinfobot on Telegram → copy your Chat ID
TELEGRAM_BOT_TOKEN=""

# GROQ API KEY (Optional — fast fallback AI model)
# Get yours free at: https://console.groq.com
GROQ_API_KEY=""

# CHROME DEBUG URL (Optional — TradingView automation bridge)
# Leave blank unless you want Jarvis to control a TradingView window.
# Start Chrome with: --remote-debugging-port=9222 --user-data-dir=$HOME/chrome-debug
# Then set this to: http://localhost:9222
CHROME_DEBUG_URL=""
