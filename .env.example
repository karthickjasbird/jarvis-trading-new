# ═══════════════════════════════════════════════════
# JARVIS TRADING — CONFIGURATION
# ═══════════════════════════════════════════════════
# Copy this file to .env and fill in your keys.
# DO NOT share your .env file with anyone.
# ═══════════════════════════════════════════════════

# YOUR IDENTITY (Required for shared Firebase)
# Sign into the app → Settings → copy your User ID
# This ensures Jarvis only monitors YOUR trades, not other users'.
OWNER_USER_ID=""

# GEMINI AI KEY (Required — powers all AI features)
# Get yours free at: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# APP URL (leave as-is for local development)
APP_URL="http://localhost:3000"

# BINANCE API KEYS (Optional — needed for live trading)
# Get yours at: https://www.binance.com/en/my/settings/api-management
# Required permissions: Enable Reading, Enable Spot & Margin Trading
BINANCE_API_KEY=""
BINANCE_SECRET_KEY=""

# TELEGRAM NOTIFICATIONS (Optional)
# 1. Message @BotFather on Telegram → /newbot → copy the token
# 2. Message @userinfobot on Telegram → copy your Chat ID
TELEGRAM_BOT_TOKEN=""

# GROQ API KEY (Optional — fast fallback AI model)
# Get yours free at: https://console.groq.com
GROQ_API_KEY=""
