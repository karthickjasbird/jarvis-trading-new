rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "karthickjasbird@gmail.com" && request.auth.token.email_verified == true));
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function isValidUser(data) {
      return data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt']) &&
             data.uid is string &&
             data.email is string &&
             data.role in ['admin', 'user'] &&
             (!('displayName' in data) || data.displayName is string) &&
             data.createdAt is string;
    }

    function isValidBrokerConfig(data) {
      return data.keys().hasOnly(['brokerName', 'apiKey', 'apiSecret', 'isActive', 'updatedAt']) &&
             data.brokerName in ['zerodha', 'binance', 'paper'] &&
             data.apiKey is string &&
             data.apiSecret is string &&
             data.isActive is bool &&
             data.updatedAt is string;
    }

    function isValidTrade(data) {
      return data.keys().hasOnly(['userId', 'symbol', 'market', 'side', 'quantity', 'entryPrice', 'exitPrice', 'status', 'pnl', 'mode', 'createdAt', 'closedAt']) &&
             data.userId is string &&
             data.symbol is string &&
             data.market in ['crypto', 'indian_equity', 'indian_options'] &&
             data.side in ['buy', 'sell'] &&
             data.quantity is number && data.quantity > 0 &&
             data.entryPrice is number && data.entryPrice > 0 &&
             data.status in ['open', 'closed', 'cancelled'] &&
             data.mode in ['copilot', 'sentry'] &&
             data.createdAt is string &&
             (!('exitPrice' in data) || data.exitPrice is number) &&
             (!('pnl' in data) || data.pnl is number) &&
             (!('closedAt' in data) || data.closedAt is string);
    }

    function isValidStrategy(data) {
      return data.keys().hasOnly(['userId', 'sentryModeActive', 'maxDailyLoss', 'targetDailyProfit', 'allowedMarkets', 'updatedAt']) &&
             data.userId is string &&
             data.sentryModeActive is bool &&
             data.maxDailyLoss is number && data.maxDailyLoss > 0 &&
             data.targetDailyProfit is number && data.targetDailyProfit > 0 &&
             data.allowedMarkets is list &&
             data.updatedAt is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isValidUser(request.resource.data) &&
                    ((isOwner(userId) && request.resource.data.role == 'user') || isAdmin());
      allow update: if isAuthenticated() && isValidUser(request.resource.data) &&
                    ((isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin());
      
      match /brokerConfigs/{configId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidBrokerConfig(request.resource.data);
        allow update: if isOwner(userId) && isValidBrokerConfig(request.resource.data);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /trades/{tradeId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidTrade(request.resource.data) && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && isValidTrade(request.resource.data) && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId;
    }

    match /strategies/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidStrategy(request.resource.data) && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(userId) && isValidStrategy(request.resource.data) && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId;
    }
  }
}
